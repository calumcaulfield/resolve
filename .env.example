# ---------------------------------------------------------------------------
# Resolve — environment configuration
#
# Every variable the code reads is listed here. Copy to `.env` and edit.
#
# The defaults below run the entire system with NO third-party API keys:
# a deterministic local model provider and a local embedder. `make demo`,
# `make test` and `make eval` all work from a clean checkout.
# ---------------------------------------------------------------------------

# --- core ------------------------------------------------------------------
RESOLVE_ENVIRONMENT=local              # local | ci | staging | production
RESOLVE_LOG_LEVEL=INFO
RESOLVE_LOG_JSON=true

# --- model provider --------------------------------------------------------
# mock       deterministic, keyless, free. The default.
# anthropic  requires `pip install 'resolve[anthropic]'` and an API key.
# openai     requires `pip install 'resolve[openai]'` and an API key.
RESOLVE_LLM_PROVIDER=mock
RESOLVE_LLM_API_KEY=
RESOLVE_LLM_BASE_URL=

# Two-tier routing: a cheap model classifies, a strong model reasons and drafts.
RESOLVE_LLM_TRIAGE_MODEL=claude-haiku-4-5
RESOLVE_LLM_REASONING_MODEL=claude-opus-5

RESOLVE_LLM_MAX_OUTPUT_TOKENS=2048
RESOLVE_LLM_REQUEST_TIMEOUT_SECONDS=60
RESOLVE_LLM_MAX_RETRIES=3

# Hard per-ticket spend ceiling. The agent escalates rather than exceeding it.
RESOLVE_LLM_BUDGET_USD_PER_TICKET=0.25

RESOLVE_LLM_CACHE_ENABLED=true
RESOLVE_LLM_CACHE_TTL_SECONDS=3600

# --- agent bounds ----------------------------------------------------------
RESOLVE_AGENT_MAX_STEPS=8
RESOLVE_AGENT_MAX_TOOL_CALLS=6
RESOLVE_AGENT_MAX_RETRIEVAL_CHUNKS=6

# Refunds at or below this amount may execute autonomously. Anything above it
# always waits for a human, regardless of how confident the model is.
RESOLVE_AGENT_REFUND_AUTO_APPROVE_LIMIT_GBP=25.0

# Minimum citations a reply must carry before it can be sent automatically.
RESOLVE_AGENT_MIN_CITATIONS_FOR_AUTO_SEND=1

# Classification confidence below which the agent escalates instead of acting.
RESOLVE_AGENT_MIN_CONFIDENCE_FOR_AUTO_ACTION=0.70

# --- database --------------------------------------------------------------
RESOLVE_DB_URL=postgresql+asyncpg://resolve:resolve@localhost:5432/resolve
RESOLVE_DB_ECHO=false
RESOLVE_DB_POOL_SIZE=10
RESOLVE_DB_MAX_OVERFLOW=20

# --- redis / event bus -----------------------------------------------------
RESOLVE_REDIS_URL=redis://localhost:6379/0
RESOLVE_REDIS_CONSUMER_GROUP=resolve
RESOLVE_REDIS_CLAIM_IDLE_MS=60000     # after this, another worker may reclaim
RESOLVE_REDIS_BLOCK_MS=5000
RESOLVE_REDIS_BATCH_SIZE=10

# --- security --------------------------------------------------------------
# Comma-separated. Rotate by adding the new key, deploying, then removing the old.
RESOLVE_SECURITY_API_KEYS=["dev-local-key"]

# Outbound webhooks may only target these hosts. Closes the SSRF class of bug.
RESOLVE_SECURITY_WEBHOOK_ALLOWED_HOSTS=["example.com"]

# Signs outbound webhook payloads (HMAC-SHA256). Must be changed in production.
RESOLVE_SECURITY_HMAC_SECRET=dev-local-hmac-secret

# Strip card numbers, emails, phone numbers and postcodes before any model call.
RESOLVE_SECURITY_REDACT_PII_BEFORE_LLM=true

# --- observability ---------------------------------------------------------
RESOLVE_OTEL_ENABLED=false
RESOLVE_OTEL_SERVICE_NAME=resolve
RESOLVE_OTEL_ENDPOINT=http://localhost:4318/v1/traces
RESOLVE_OTEL_METRICS_PORT=9464

# --- console / seeding -----------------------------------------------------
RESOLVE_API_URL=http://localhost:8000
RESOLVE_API_KEY=dev-local-key
